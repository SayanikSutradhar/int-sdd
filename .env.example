# ============================================================
# Employee Internal Transfer — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employee_transfer_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
JWT_EXPIRES_IN=15m

# Cookie Configuration
COOKIE_SECRET=your_cookie_secret_here_minimum_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# CORS
CORS_ORIGIN=http://localhost:5173
